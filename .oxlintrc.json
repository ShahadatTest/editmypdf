{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "pdfjs-dist",
            "importNames": ["getDocument"],
            "message": "Open documents with openDocument() from src/pdf.ts, which gives pdf.js the addresses of its wasm decoders, CMaps, ICC profile and standard fonts."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/pdf.ts"],
      "rules": { "no-restricted-imports": "off" }
    }
  ]
}
